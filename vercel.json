{
  "version": 2,
  "routes": [
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/api/config", "dest": "/api/config.py" },
    { "src": "/api/setup", "dest": "/api/setup.py" },
    { "src": "/api/stories", "dest": "/api/stories.py" },
    { "src": "/api/app-cards/connect", "dest": "/api/app_cards_connect.py" },
    { "src": "/api/app-cards/([^/]+)/refresh", "dest": "/api/app_cards_refresh.py?app_card_id=$1" },
    { "src": "/api/app-cards/([^/]+)", "dest": "/api/app_cards_detail.py?app_card_id=$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
