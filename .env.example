OPENPROJECT_BASE_URL=https://openproject.example.com
OPENPROJECT_API_TOKEN=replace-me
OPENPROJECT_AUTH_MODE=basic
OPENPROJECT_VERSION_NAME=Release 1.0
OPENPROJECT_STORY_TYPE=User story

MIRO_BASE_URL=https://api.miro.com/v2
MIRO_ACCESS_TOKEN=replace-me
MIRO_CLIENT_ID=replace-me
MIRO_CLIENT_SECRET=replace-me
MIRO_OAUTH_REDIRECT_URI=https://your-domain.vercel.app/api/oauth/callback
MIRO_BOARD_ID=replace-me
MIRO_ASSIGNEE_MAP_JSON={}
MIRO_APP_PUBLIC_URL=http://localhost:8787
APP_BACKEND_HOST=127.0.0.1
APP_BACKEND_PORT=8787
APP_DATA_FILE=.data/app_card_links.json

# JSON object mapping OpenProject status names to x/y positions on the Miro board.
# Example:
# {"New":{"x":-1200,"y":0},"In progress":{"x":0,"y":0},"Closed":{"x":1200,"y":0}}
MIRO_COLUMNS_JSON={"New":{"x":-1200,"y":0},"In progress":{"x":0,"y":0},"Closed":{"x":1200,"y":0}}
MIRO_CARD_VERTICAL_SPACING=260
